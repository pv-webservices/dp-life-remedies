{
  "name": "dp-life-remedies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test:unit": "node --test \"tests/*.test.ts\"",
    "audit": "astro build && node scripts/audit-seo.mjs",
    "test:forms": "node scripts/test-forms.mjs",
    "verify": "node scripts/verify.mjs",
    "test:e2e": "node scripts/test-forms.mjs && node scripts/verify.mjs",
    "test": "npm run check && npm run test:unit && npm run audit",
    "assets": "node scripts/prepare-assets.mjs",
    "format": "prettier --write src scripts tests *.md docs",
    "images": "node scripts/generate-images.mjs",
    "images:plan": "node scripts/generate-images.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "node-html-parser": "^7.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
