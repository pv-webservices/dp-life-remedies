---
// Custom 404: Netlify serves dist/404.html with a real 404 status for any unknown URL.
// noindex, no canonical, not in the sitemap.
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { divisions } from '../data/products';
import { business, whatsapp } from '../data/business';
const sections = [
  { href: '/', label: 'Home', icon: 'leaf' },
  { href: '/product-divisions/', label: 'All products', icon: 'grid' },
  { href: '/about/', label: 'About us', icon: 'people' },
  { href: '/why-us/', label: 'Why DP Life Remedies', icon: 'shield' },
  { href: '/contact/', label: 'Contact & enquiries', icon: 'mail' },
];
---

<Layout
  title="Page Not Found"
  description="The page you were looking for could not be found. Explore DP Life Remedies product divisions, company pages or contact our team."
  noindex
>
  <section class="section not-found">
    <div class="container narrow">
      <span class="not-found-code" aria-hidden="true" data-code="404"></span>
      <p class="eyebrow">Error 404 · Page not found</p>
      <h1>
        Let’s get you <span class="accent">back on track.</span>
      </h1>
      <p class="lede">
        We couldn’t find that page. It may have moved, or the link may be
        mistyped. Try one of these instead, or call us on{' '}
        <a href={`tel:${business.tel}`}>{business.phone}</a>.
      </p>
      <div class="btn-row">
        <a class="btn" href="/">
          Back to home <Icon name="arrow" size={18} />
        </a>
        <a class="btn outline" href="/contact/">
          Contact our team
        </a>
        <a
          class="btn whatsapp"
          href={whatsapp()}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={18} /> WhatsApp
        </a>
      </div>
      <h2 class="not-found-heading">Main sections</h2>
      <ul class="not-found-links">
        {sections.map((s) => (
          <li>
            <a href={s.href}>
              <Icon name={s.icon} size={18} /> {s.label}
            </a>
          </li>
        ))}
      </ul>
      <h2 class="not-found-heading">Product divisions</h2>
      <ul class="not-found-links">
        {divisions.map((d) => (
          <li>
            <a href={`/product-divisions/${d.slug}/`}>
              <Icon name={d.icon} size={18} /> {d.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
