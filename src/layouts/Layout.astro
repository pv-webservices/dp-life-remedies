---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/sections.css';
import '../styles/catalogue.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { business, whatsapp } from '../data/business';
import { siteGraph, breadcrumbGraph, jsonLd } from '../data/schema';
interface Props {
  title: string;
  /** Use the title as-is instead of appending the brand (keeps long titles under ~65 chars). */
  rawTitle?: boolean;
  description?: string;
  /** Site-relative 1200×630 Open Graph image. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  crumbs?: { name: string; path: string }[];
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
}
const {
  title,
  rawTitle = false,
  description = 'DP Life Remedies is a pharmaceutical and healthcare products wholesaler in Ramgarh, Panchkula, Haryana: tablets, softgels, syrups, oral solutions and nutrition.',
  image = '/media/og/default.jpg',
  imageAlt = 'Smiling family from the DP Life Remedies brand creative',
  noindex = false,
  crumbs = [],
  schema = [],
} = Astro.props;
const site = Astro.site!;
const pageUrl = new URL(Astro.url.pathname, site).href;
const fullTitle = rawTitle ? title : `${title} | DP Life Remedies`;
const graph = [
  ...siteGraph(site),
  ...(crumbs.length > 1 ? [breadcrumbGraph(site, crumbs)] : []),
  ...schema,
];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'
      }
    />
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <link
      rel="preload"
      href={jakartaLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#0a2250" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL(image, site).href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, site).href} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      )
        document.documentElement.classList.add('motion-ok');
      // Never leave reveal content hidden if the site script fails to load.
      setTimeout(() => {
        if (!window.dpReady)
          document.documentElement.classList.remove('motion-ok');
      }, 2500);
    </script>
    <script type="application/ld+json" set:html={jsonLd(graph)} />
  </head>
  <body>
    <div class="page-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="float-actions" data-float>
      <a
        class="float-btn wa"
        href={whatsapp()}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Enquire on WhatsApp"
      >
        <Icon name="whatsapp" size={24} />
      </a>
      <a
        class="float-btn call"
        href={`tel:${business.tel}`}
        aria-label={`Call ${business.phone}`}
      >
        <Icon name="phone" size={22} />
      </a>
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
