---
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/sections.css';
import '../styles/catalogue.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { business, whatsapp } from '../data/business';
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  crumbs?: { name: string; path: string }[];
}
const {
  title,
  description = 'DP Life Remedies is a pharmaceutical and healthcare products wholesaler in Ramgarh, Panchkula, Haryana. Explore tablets, softgel capsules, syrups, oral solutions and nutrition products.',
  image = '/media/brand/social.webp',
  noindex = false,
  crumbs = [],
} = Astro.props;
const base = import.meta.env.PUBLIC_SITE_URL;
const canonical = base ? new URL(Astro.url.pathname, base).href : undefined;
const fullTitle = `${title} | DP Life Remedies`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: business.name,
  telephone: business.tel,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress:
      'Shop No. 2, Ground Floor, Near Dharamshala, Village Ramgarh',
    addressLocality: 'Panchkula',
    addressRegion: 'Haryana',
    postalCode: '134118',
    addressCountry: 'IN',
  },
  ...(base
    ? { url: base, logo: new URL('/media/brand/logo-320.webp', base).href }
    : {}),
};
const json = (value: unknown) =>
  JSON.stringify(value).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a2250" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={base && !noindex ? 'index,follow' : 'noindex,nofollow'}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {base && (
      <>
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(image, base).href} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      )
        document.documentElement.classList.add('motion-ok');
      // Never leave reveal content hidden if the site script fails to load.
      setTimeout(() => {
        if (!window.dpReady)
          document.documentElement.classList.remove('motion-ok');
      }, 2500);
    </script>
    <script type="application/ld+json" set:html={json(org)} />
    {base && crumbs.length > 0 && (
      <script
        type="application/ld+json"
        set:html={json({
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: crumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            item: new URL(c.path, base).href,
          })),
        })}
      />
    )}
  </head>
  <body>
    <div class="page-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="float-actions" data-float>
      <a
        class="float-btn wa"
        href={whatsapp()}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Enquire on WhatsApp"
      >
        <Icon name="whatsapp" size={24} />
      </a>
      <a
        class="float-btn call"
        href={`tel:${business.tel}`}
        aria-label={`Call ${business.phone}`}
      >
        <Icon name="phone" size={22} />
      </a>
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
