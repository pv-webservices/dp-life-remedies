---
import { productImage, productSrcset, type Product } from '../data/products';
interface Props {
  items: Product[];
}
const { items } = Astro.props;
const shown = items.slice(0, 3);
---

<div class:list={['pack-cluster', `count-${shown.length}`]}>
  {shown.map((p, i) => (
    <a
      class={`stage ${p.color}`}
      href={`/products/${p.slug}/`}
      aria-label={`View ${p.name}`}
    >
      <img
        src={productImage(p.slug, 640)}
        srcset={productSrcset(p.slug, [320, 480, 640])}
        sizes="(max-width: 560px) 200px, 340px"
        width="640"
        height="480"
        alt=""
        loading="eager"
        fetchpriority={i === 0 ? 'high' : undefined}
      />
    </a>
  ))}
</div>
