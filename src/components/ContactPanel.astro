---
import Icon from './Icon.astro';
import { business, whatsapp } from '../data/business';
interface Props {
  title?: string;
  text?: string;
  product?: string;
}
const {
  title = 'We’re here to talk.',
  text = 'A product question, a wholesale requirement or the start of a trade partnership — reach our team directly.',
  product = '',
} = Astro.props;
const methods = [
  {
    icon: 'phone',
    label: 'Call our team',
    value: business.phone,
    href: `tel:${business.tel}`,
  },
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: 'Message us on WhatsApp',
    href: whatsapp(product),
    external: true,
  },
  {
    icon: 'mail',
    label: 'Email',
    value: business.email,
    href: `mailto:${business.email}`,
  },
  {
    icon: 'location',
    label: 'Office',
    value: business.address,
    href: business.maps,
    external: true,
  },
];
---

<aside class="contact-panel on-dark" data-reveal="left">
  <p class="eyebrow">Contact DP Life Remedies</p>
  <h2>{title}</h2>
  <p>{text}</p>
  <ul class="contact-methods">
    {methods.map((m) => (
      <li>
        <a
          href={m.href}
          {...(m.external
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <span class="icon-tile">
            <Icon name={m.icon} size={22} />
          </span>
          <span>
            <small>{m.label}</small>
            <strong>{m.value}</strong>
          </span>
          <Icon name="arrow-up-right" size={18} class="contact-go" />
        </a>
      </li>
    ))}
  </ul>
  <p class="contact-note">
    <Icon name="shield" size={18} />
    For healthcare and trade enquiries. Please share business requirements only
    — patient information is not needed.
  </p>
  <p class="footer-gst">
    <Icon name="badge" size={16} /> GSTIN <strong>{business.gstin}</strong>
  </p>
</aside>
