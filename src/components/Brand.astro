---
import Logo from './Logo.astro';
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<a href="/" class:list={['brand', { light }]}>
  <span class="brand-mark">
    <Logo size={62} lazy={light} />
  </span>
  <span class="brand-word">
    <strong>DP Life Remedies</strong>
    <small>
      Health <i aria-hidden="true">•</i> Trust <i aria-hidden="true">•</i> Care
    </small>
  </span>
</a>
