# The website needs no environment variables: the canonical URL lives in src/data/site.mjs and
# enquiry forms use FormSubmit (no SMTP, passwords or API keys).

# Optional: build against another origin for isolated QA (never set this on Netlify).
# PUBLIC_SITE_URL=https://qa.example

# Optional, server-side only: used by `npm run images`. Never commit a real key or expose it to the browser.
OPENAI_API_KEY=
# Optional overrides for the image models (defaults live in image-generation.config.mjs).
# OPENAI_IMAGE_MODEL_STANDARD=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_PREMIUM=gpt-image-2.5-sunburst
