# Public origin used for canonical URLs, sitemap and indexing (set before the final build).
PUBLIC_SITE_URL=https://your-approved-domain.example

# Server-side only: used by `npm run images`. Never commit a real key or expose it to the browser.
OPENAI_API_KEY=
# Optional overrides for the image models (defaults live in image-generation.config.mjs).
# OPENAI_IMAGE_MODEL_STANDARD=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL_PREMIUM=gpt-image-2.5-sunburst
